MAIL_HOST=your-mail-host         # e.g., smtp.gmail.com
MAIL_PORT=your-mail-port         # e.g., 465 for SSL
MAIL_USERNAME=your-mail-username # Your email username/address
MAIL_PASSWORD=your-mail-password # Your email password or app password
MAIL_FROM=your-mail-from-address # The "from" address for sent emails
MAIL_TLS=false                   # Set to true if your SMTP server requires TLS
MAIL_START_TLS=REQUIRED          # Set to REQUIRED if your SMTP server requires STARTTLS

EMAIL_BCC_ADDRESS=               # Optional BCC address for all outgoing emails

APP_URL=http://localhost:8080 # The base URL for the application (frontend)

# Passkey / WebAuthn configuration
# WEBAUTHN_RP_ID: the site's bare domain the passkey is bound to — hostname only, no scheme/port/path (e.g. example.com or localhost)
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS: comma-separated full origin URLs the frontend is served from
WEBAUTHN_ORIGINS=http://localhost:8080,http://localhost:3000

# Web Push (VAPID) configuration
# Without these, a new key pair is generated on every startup, which invalidates every existing
# browser push subscription on restart. Base64URL-encoded (no padding): the public key is the
# 65-byte uncompressed EC point, the private key is the raw 32-byte scalar - both secp256r1.
SEATRESERVATION_VAPID_PUBLIC_KEY=
SEATRESERVATION_VAPID_PRIVATE_KEY=
# SEATRESERVATION_VAPID_SUBJECT: contact address push services may use to reach you about this app
SEATRESERVATION_VAPID_SUBJECT=mailto:admin@example.com


# For docker deployment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=seatReservation

# ALTCHA CAPTCHA HMAC secret
# Generate one with: openssl rand -base64 32
ALTCHA_SECRET=